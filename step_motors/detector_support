  def cmd_increase(self):
    "BtnIncrement callback"
    step = int(self.EntStep.get())
    if step < 20000:   step *= 2
    self.EntStep.delete("0", tk.END)
    self.EntStep.insert("0", step)


  def cmd_decrease(self):
    "BtnDecrement callback"
    step = int(self.EntStep.get())
    if step > 1:
      step //= 2
    self.EntStep.delete("0", tk.END)
    self.EntStep.insert("0", step)

  def start_edit_handler(self, event):
    self.EntStep.focus_force()
    self.EntStep.select_to(tk.END)

  def finish_edit_handler(self, event):
    step = ""
    for i in self.EntStep.get():
      if i.isdigit():
        step += i
    if not step or not int(step):
      step = str(self.AUTO_STEP)
    self.EntStep.delete("0", tk.END)
    self.EntStep.insert("0", step)
    self.LblStatus.focus_force()


  def btn_event_handler(self, event, button):
    "Universal event handler to emulate user mouse click"
    current_focused_widget = self.focus_get()
    button.focus_set()
    button.event_generate("<KeyPress-space>")
    current_focused_widget.focus_set()


  def bind_events(self):
    self.LblStatus.focus_force()
#widgets able to take focus except Entry
    for obj in self.winfo_children():
      if obj.winfo_class() != "Entry":
        obj.bind("<KeyPress-Right>", lambda evt: self.btn_event_handler(evt, self.BtnRight))
        obj.bind("<KeyPress-Left>", lambda evt: self.btn_event_handler(evt, self.BtnLeft))
        obj.bind("<KeyPress-KP_Add>", lambda evt: self.btn_event_handler(evt, self.BtnIncr))
        obj.bind("<KeyPress-KP_Subtract>", lambda evt: self.btn_event_handler(evt, self.BtnDecr))
        obj.bind("<KeyPress-e>", lambda evt: self.start_edit_handler(evt))
    self.EntStep.bind("<KeyPress-Return>", self.finish_edit_handler)
    self.EntStep.bind("<KeyPress-KP_Enter>", self.finish_edit_handler)


  def print_status(self, message):
    "Represents status in bottom side of the application window"
    self.LblStatus["text"] = "Status: " + message


