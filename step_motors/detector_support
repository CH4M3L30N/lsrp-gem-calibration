  def cmd_move(self, direction, sign):
    '''Move motors'''
#    t = time.time()
    self.print_status("busy")
    try:
      self.move(direction, sign*int(self.EntStep.get()))
    except ValueError:
      self.status["state"] = "wrong step"
    except serial.SerialException:
      self.status["state"] = "no connection"
      print("Connection error!")
    except motor_devices.PowerFail as fail:
      self.status["state"] = "no power"
      print("Power fail of device #", fail.N)
    self.update_status()
#    print("Motor time:", time.time()-t)


  def cmd_reset(self):
    "BtnReset callback"
    self.print_status("busy")
    try:
      self.reset_coordinate()
    except serial.SerialException:
      self.status["state"] = "no connection"
      print("Connection error!")
    except motor_devices.PowerFail as fail:
      self.status["state"] = "no power"
      print("Power fail of device #", fail.N)
    self.update_status()
      

  def cmd_return(self):
    "It is a BtnReturn callback"
    self.print_status("busy")
    try:
      self.move_to_zero()
    except serial.SerialException:
      self.status["state"] = "no connection"
      print("Connection error!")
    except motor_devices.PowerFail as fail:
      self.status["state"] = "no power"
      print("Power fail of device #", fail.N)
    self.update_status()
    
    
  def cmd_calibrate(self):
    "It is a BtnCalibrate callback"
    try:
      self.calibrate()
      self.preset = None
      self.PresetName.set("<calibrated>")
    except (serial.SerialException, devices.PowerFail):
      raise
    self.update_status()


  def start_auto(self):
    if self.DoAuto.get():
      self.auto_thread = threading.Thread(target=self.auto,
                         name="detector_support_auto_thread")
      self.auto_thread.start()
      self.BtnUp.config(state=tk.DISABLED)
      self.BtnDown.config(state=tk.DISABLED)
      self.BtnRight.config(state=tk.DISABLED)
      self.BtnLeft.config(state=tk.DISABLED)
      self.EntStep.config(state=tk.DISABLED)
      self.BtnIncr.config(state=tk.DISABLED)
      self.BtnDecr.config(state=tk.DISABLED)
      self.BtnCalibrate.config(state=tk.DISABLED)
      self.MnPreset.config(state=tk.DISABLED)
      self.BtnSave.config(state=tk.DISABLED)
    else:
      self.auto_thread.join()
      self.BtnUp.config(state=tk.NORMAL)
      self.BtnDown.config(state=tk.NORMAL)
      self.BtnRight.config(state=tk.NORMAL)
      self.BtnLeft.config(state=tk.NORMAL)
      self.EntStep.config(state=tk.NORMAL)
      self.BtnIncr.config(state=tk.NORMAL)
      self.BtnDecr.config(state=tk.NORMAL)
      self.BtnCalibrate.config(state=tk.NORMAL)
      self.MnPreset.config(state=tk.NORMAL)
      self.BtnSave.config(state=tk.NORMAL)
    self.thread_sync.clear()
    # launch later
    self.after(1000*int(self.REFR_TIME), self.update_status)


  def update_status(self):
    "It is a function to check and represent status of motors: its trailers and Mirrors"
    try:  
      self.LblX[1]["text"] = "{:+6}".format(self.status["x"])
      self.LblX[2]["text"] = "{:+7.2f} mm".format(self.SCALE[0]*self.status["x"])
      self.LblY[1]["text"] = "{:+6}".format(self.status["y"])
      self.LblY[2]["text"] = "{:+7.2f} mm".format(self.SCALE[1]*self.status["y"])

      self.LblX[0].update()
      self.LblX[1].update()
      self.LblY[0].update()
      self.LblY[1].update()

      
      if not self.DoAuto.get():
        if self.status["y_edges"][1]:
          self.BtnUp.config(state=tk.DISABLED, bg="red")
        else:
          self.BtnUp.config(state=tk.NORMAL, bg=self.def_color)
        if self.status["y_edges"][0]:
          self.BtnDown.config(state=tk.DISABLED, bg="red")
        else:
          self.BtnDown.config(state=tk.NORMAL, bg=self.def_color)
        if self.status["x_edges"][1]:
          self.BtnRight.config(state=tk.DISABLED, bg="red")
        else:
          self.BtnRight.config(state=tk.NORMAL, bg=self.def_color)
        if self.status["x_edges"][0]:
          self.BtnLeft.config(state=tk.DISABLED, bg="red")
        else:
          self.BtnLeft.config(state=tk.NORMAL, bg=self.def_color)
      
      if   self.status["K+"][0]: self.LblK1.configure(text="1:K+", bg="red")
      elif self.status["K-"][0]: self.LblK1.configure(text="1:K-", bg="red")
      else:                      self.LblK1.configure(text="", bg=self.def_color)
      
      if   self.status["K+"][1]: self.LblK2.configure(text="2:K+", bg="red")
      elif self.status["K-"][1]: self.LblK2.configure(text="2:K-", bg="red")
      else:                      self.LblK2.configure(text="", bg=self.def_color)
      self.print_status(self.status["state"])
      
      if self.DoAuto.get():
        self.thread_sync.set()
        self.after(1000*int(self.REFR_TIME), self.update_status)  # doesn't spend time

    except KeyError: 
      raise #pass


  def cmd_go_to_preset(self, preset_name):
    try:
# auto save
#      if self.preset is not None:
#        self.save_config()
      if preset_name == "<new preset>":
        self.save_config(len(self.preset_names))
        self.move_to(len(self.preset_names))
        self.save_config()
      elif preset_name == "<no preset>":
        self.preset = None
      else:
        # existing preset
        new_preset = self.preset_names.index(preset_name)
        self.move_to(new_preset)
        self.preset = new_preset
    except (serial.SerialException, devices.PowerFail):
      pass
    self.update_status()




def is_launched():
  appname = sys.argv[0]
  appcopies = []
  for i in os.popen('ps -ef | grep %s' % (appname)).readlines():
    if 'python' in i:
      appcopies.append(i)
  if len(appcopies)==1:   return False
  else:
    print('Another instance of %s had been already launched. \nTo work further, terminate it first (get PID by "ps -ef | grep %s").' % (appname, appname))
    return True


if __name__ == "__main__":
  if is_launched():
    sys.exit()
  app = Application()
  app.master.title("Detector support")
  app.mainloop()
