# number of string in loads file = number of counter channel
#LOADS_CHANNEL = 0
# minimum load in Auto regime
#MIN_LOAD = 500
#MAX_REL_LOAD = 2500
# the number of measurements which are averaged in Auto regime
#MA_PERIOD = 4
# the number of steps of motor in Auto regime
AUTO_STEP = 100
# saved mirror positions
X = [9290, 36400, 40000, 0]
Y = [16855, 12500, 1000, 31000]

[Presets]
NAME = [Laser polarimeter, Test beam, Off the beam]

